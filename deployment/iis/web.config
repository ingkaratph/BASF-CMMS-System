<?xml version="1.0" encoding="utf-8"?>
<!-- IIS on pd.local exposes port 80. Node listens on loopback port 3000
     ON THE SAME pd.local MACHINE. Requires IIS URL Rewrite + ARR.
     Set ARR preserveHostHeader=true at server level before enabling this site.
     Keep the CMMS source and .env outside this IIS physical directory. -->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="CMMS reverse proxy" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:3000/{R:1}" appendQueryString="true" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
