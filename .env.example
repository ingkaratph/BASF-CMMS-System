CMMS_API_BASE_URL=http://mt.local:1880
CMMS_API_KEY=
CMMS_API_KEY_ADMIN=
# database: SQL-backed accounts through the private identity API (no local fallback).
# local: isolated development/tests only.
CMMS_IDENTITY_STORAGE=database
# Bootstrap admin account password (username: admin). Afterwards manage users in the app.
# Optional: CMMS_USERS_FILE=server/users.local.json
# Run on the machine resolved by pd.local; listen on all IPv4 interfaces.
HOST=0.0.0.0
PORT=80
# Required to allow LAN access. Use a long random password.
CMMS_APP_PASSWORD=

# Local uploaded photos and drawings; back up this whole directory.
CMMS_MEDIA_DIR=server/uploads
